{
    "name": "yiirocks/voyti-social-auth",
    "description": "Social/OAuth2 login addon for Voyti: sign in and register via Google, GitHub, Facebook, and more",
    "type": "library",
    "keywords": [
        "yii",
        "yii3",
        "user",
        "auth",
        "oauth2",
        "social",
        "extension"
    ],
    "homepage": "https://www.yii.rocks/voyti/social/",
    "license": "BSD-3-Clause",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Mr.42",
            "homepage": "https://mr42.me/",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/YiiRocks/voyti-social-auth/issues",
        "source": "https://github.com/YiiRocks/voyti-social-auth/tree/main"
    },
    "require": {
        "php": ">=8.3",
        "psr/http-message": "^1.0 || ^2.0",
        "psr/http-server-middleware": "^1.0",
        "yiirocks/voyti": "^1.0",
        "yiisoft/yii-auth-client": "dev-master"
    },
    "require-dev": {
        "ext-pdo_sqlite": "*",
        "friendsofphp/php-cs-fixer": "@stable",
        "infection/infection": "^0.35.0",
        "nyholm/psr7": "^1.8",
        "phpunit/phpunit": "@stable",
        "rector/rector": "^2.1.1",
        "vimeo/psalm": "^6.0",
        "yiirocks/voyti-views-bootstrap5": "^1.0",
        "yiisoft/code-style": "^1.1",
        "yiisoft/config": "^1.6",
        "yiisoft/db-sqlite": "^2.0",
        "yiisoft/di": "*",
        "yiisoft/router-fastroute": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "YiiRocks\\Voyti\\SocialAuth\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "YiiRocks\\Voyti\\SocialAuth\\tests\\": "tests"
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "scripts": {
        "php-cs-fixer": "@php vendor/bin/php-cs-fixer fix",
        "phpunit": "@php vendor/bin/phpunit",
        "psalm": "@php vendor/bin/psalm",
        "infection": "@php vendor/bin/infection --configuration=infection.json --min-msi=100 --min-covered-msi=100",
        "rector": "@php vendor/bin/rector process"
    },
    "scripts-descriptions": {
        "php-cs-fixer": "Cleans to code with PHP Coding Standards Fixer.",
        "phpunit": "PHPUnit - programmer-oriented testing framework.",
        "psalm": "Psalm - static analysis tool for finding errors in PHP applications.",
        "infection": "Infection - PHP Mutation Testing Framework.",
        "rector": "Rector - automated tool for refactoring and upgrading PHP code."
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "config-plugin-options": {
            "source-directory": "config"
        },
        "config-plugin": {
            "params": "params.php",
            "params-console": "params-console.php",
            "di": "di.php",
            "voyti-routes": "routes.php"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "yiisoft/config": true
        }
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/YiiRocks"
        }
    ]
}
